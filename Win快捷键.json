[
	{"keys":["ctrl+d"],"command":"duplicate_line"},
	{ "keys": ["ctrl+["], "command": "fold" },
	{ "keys": ["ctrl+]"], "command": "unfold" },
    { "keys": ["ctrl+shift+["], "command": "fold_by_level", "args": {"level": 0} },
    { "keys": ["ctrl+shift+]"], "command": "unfold_all" },
	{ "keys": ["ctrl+b"], "command": "toggle_side_bar" },
	{ "keys": ["ctrl+r"], "command": "show_panel", "args": {"panel": "replace", "reverse": false} },
	{ "keys": ["ctrl+forward_slash"], "command": "toggle_comment", "args": { "block": false } },
	{ "keys": ["ctrl+m"], "command": "move_to", "args": {"to": "brackets"} },
	{ "keys": ["ctrl+shift+k"], "command": "run_macro_file", "args": {"file": "res://Packages/Default/Delete Line.sublime-macro"} },
	{"keys":["ctrl+shift+d"],
		"command":"compare_python_dicts",
		"context":[
			{
				"key":"selector",
				"operator":"equal",
				"operand":"source.python"
			}
		]
	},
	{ "keys": ["ctrl+j", "ctrl+c"], "command": "copy_json_path"},
    {
        "keys": ["ctrl+shift+j"],
        "command": "jq_custom_query"
    },
    {
        "keys": ["ctrl+l", "ctrl+p"],
        "command": "curl_to_requests"
    },
    {
        "keys":["ctrl+q"],
        "command": "json_to_dict"
    }
]